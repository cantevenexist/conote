{
  "manifest_version": 3,
  "name": "Conote",
  "version": "1.0",
  "description": "Conote extension",
  "permissions": [
    "activeTab",
    "storage",
    "cookies"
  ],
  
  "action": {
    "default_popup": "popup.html",
    "default_title": "Conote"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["popup.js"],
      "css": ["styles.css"]
    }
  ]
}