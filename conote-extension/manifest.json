{
  "manifest_version": 3,
  "name": "Conote",
  "version": "1.0",
  "description": "Conote extension - управление рабочими пространствами и канбан-досками",
  "permissions": [
    "storage",
    "cookies",
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://your-domain.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Conote"
  },
  "background": {
    "service_worker": "background.js"
  }
}